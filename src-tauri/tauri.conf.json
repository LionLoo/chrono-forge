{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chrono Forge",
  "version": "0.1.0",
  "identifier": "com.lionloo.chronoforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Chrono Forge",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Focus while an autonomous civilization grows.",
    "longDescription": "Chrono Forge is a local-first focus timer and autonomous civilization simulator.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
