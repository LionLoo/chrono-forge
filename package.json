{
  "name": "chrono-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first focus timer where an autonomous civilization builds itself.",
  "license": "MIT",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "packageManager": "npm@11.6.1",
  "overrides": {
    "@puppeteer/browsers": "3.2.1",
    "deepmerge-ts": "8.0.0",
    "serialize-javascript": "7.0.5"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "preview": "vite preview",
    "tauri": "tauri",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build",
    "build:desktop": "tauri build",
    "build:e2e:web": "vite build --mode desktop-e2e",
    "build:e2e:desktop": "tauri build --config src-tauri/tauri.e2e.conf.json --features desktop-e2e",
    "format": "prettier . --write && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:check": "npm run format:check:web && npm run format:check:rust",
    "format:check:web": "prettier . --check",
    "format:check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "lint": "npm run lint:web && npm run lint:rust",
    "lint:web": "eslint . --max-warnings 0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --maxWorkers=1",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:property": "vitest run tests/property",
    "test:determinism": "vitest run tests/determinism",
    "test:sim:long": "vitest run tests/long",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "test:e2e:web": "npm run build:web && playwright test",
    "test:e2e:desktop": "npm run build:e2e:desktop && wdio run wdio.conf.mjs",
    "verify:production-exclusion": "npm run build:desktop && node tests/e2e-desktop/verify-production-exclusion.mjs",
    "bench": "vitest bench --run",
    "generate:sbom": "node scripts/generate-sbom.mjs release-artifacts/chrono-forge.cdx.json",
    "ci:web": "npm run format:check:web && npm run lint:web && npm run typecheck && npm run test && npm run build:web",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:rust && npm run test:e2e:web && npm run test:e2e:desktop && npm run generate:sbom && npm run verify:production-exclusion"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-notification": "2.3.3",
    "pixi.js": "8.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.4.1",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "@wdio/globals": "9.31.1",
    "@wdio/cli": "9.31.1",
    "@wdio/local-runner": "9.31.1",
    "@wdio/mocha-framework": "9.31.1",
    "@wdio/spec-reporter": "9.31.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "patch-package": "8.0.1",
    "prettier": "3.9.6",
    "quickjs-wasi": "2.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "webdriverio": "9.31.1"
  }
}
